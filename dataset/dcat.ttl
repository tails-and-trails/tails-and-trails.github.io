<https://tails-and-trails.github.io/#distribution-integrity-registry> a dcat:Distribution ;
  dcterms:title "Bitcoin-anchored SHA-256 integrity registry"@en ;
  dcterms:description "OpenTimestamps release manifest and Merkle root with an independently verifiable inclusion proof for each of the 173 images."@en ;
